# Keep these values on the Python server, never in NEXT_PUBLIC_ variables.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_LABEL_TABLE=item_labels
SUPABASE_LABEL_ID_COLUMN=id
SUPABASE_LABEL_NAME_COLUMN=name
SUPABASE_LABEL_MODEL_COLUMN=model_label
SUPABASE_LABEL_ACTIVE_COLUMN=is_active
LABEL_CACHE_SECONDS=60

# cpu, mps (Apple Silicon), cuda:0, or auto
MODEL_DEVICE=auto
MODEL_CONFIDENCE=0.25
MODEL_IMAGE_SIZE=640
MODEL_MAX_DETECTIONS=20
MAX_UPLOAD_MB=10

# Optional shared key for server-to-server access (X-API-Key header).
# Configure this before exposing the server outside your computer.
MODEL_SERVER_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
